///|
test "REVIEW R01 repeated center augmentation" {
  let p = two_level([factor("x", -1.0, 1.0)])
  let p = add_centers(p, 1)
  assert_eq(add_centers(p, 1).runs.length(), 4)
}

///|
test "REVIEW R01 chained foldover and bounded long identifiers" {
  let fs = [factor("x", -1.0, 1.0)]
  let p = foldover(two_level(fs), 1)
  assert_eq(foldover(p, 1).runs.length(), 8)
  let id = "a".repeat(128)
  let q = plan(fs, [{ id, block: 7, point: [0.0], }])
  assert_eq(replicate(q, 2).runs.length(), 2)
}

///|
test "REVIEW R02 subnormal endpoint mapping" {
  let f = factor("tiny", 0.0, 5.0e-324)
  assert_eq(decode(f, 1.0), f.high)
  assert_eq(encode(f, f.low), -1.0)
  assert_eq(encode(f, f.high), 1.0)
}

///|
test "REVIEW R03 autogenerated polynomial name collisions" {
  let fs = [factor("Intercept", -1.0, 1.0), factor("Intercept^2", -1.0, 1.0)]
  let m = terms(fs, 2)
  assert_eq(m.length(), 6)
  assert_eq(evaluate_terms([2.0, 3.0], m), [1.0, 2.0, 3.0, 6.0, 4.0, 9.0])
}

///|
test "REVIEW R01 replication of maximum length identifiers" {
  let fs = [factor("x", -1.0, 1.0)]
  let id = "a".repeat(128)
  let p = plan(fs, [{ id, block: 7, point: [0.0], }])
  assert_eq(replicate(p, 2).runs.length(), 2)
}

///|
test "REVIEW R04 CSV output respects decoder text budget" {
  let fs = [ for i in 0..<16 => factor("f\{i}", -1.0, 1.0) ]
  let p = plan(
    fs,
    [
      for i in 0..<4096 => {
        {
          id: "\"".repeat(120) + i.to_string(),
          block: 0,
          point: Array::make(16, 1.2345678901234567e99),
        }
      }
    ],
  )
  let text = plan_csv(p) catch {
    DesignError::Budget(_) => return
    e => raise e
  }
  assert_true(text.length() <= 2000000)
  assert_eq(plan_from_csv(text, fs), p)
}

///|
test "REVIEW R04 JSON output respects decoder text budget" {
  let fs = [ for i in 0..<16 => factor("f\{i}", -1.0, 1.0) ]
  let p = plan(
    fs,
    [
      for i in 0..<4096 => {
        {
          id: "\"".repeat(120) + i.to_string(),
          block: 0,
          point: Array::make(16, 1.2345678901234567e99),
        }
      }
    ],
  )
  let text = plan_json(p) catch {
    DesignError::Budget(_) => return
    e => raise e
  }
  assert_true(text.length() <= 2000000)
  assert_eq(plan_from_json(text), p)
}

///|
test "REVIEW R01 generated IDs cannot shadow user IDs and inputs stay isolated" {
  let fs = [factor("x", -1.0, 1.0)]
  let p = plan(fs, [
    { id: "center1", block: 3, point: [-1.0], },
    { id: "fold:center1", block: 3, point: [1.0], },
    { id: "fold:1", block: 3, point: [0.0], },
  ])
  let q = add_centers(foldover(p, 1), 2, block=7)
  assert_eq(q.runs.length(), 8)
  for i in 0..<3 {
    assert_eq(q.runs[i], p.runs[i])
  }
  q.runs[0].point[0] = 0.25
  assert_eq(p.runs[0].point, [-1.0])
  validate_plan(q)
}

///|
test "REVIEW R02 subnormal interval family and extrapolation" {
  let unit = 5.0e-324
  for low in [-3.0 * unit, 0.0, 2.0 * unit] {
    let f = factor("tiny", low, low + 3.0 * unit)
    assert_eq(encode(f, f.low), -1.0)
    assert_eq(encode(f, f.high), 1.0)
    assert_eq(decode(f, -1.0), f.low)
    assert_eq(decode(f, 1.0), f.high)
    assert_true((encode(f, low + unit) + 1.0 / 3.0).abs() < 1.0e-14)
  }
  let f = factor("normal", 10.0, 30.0)
  assert_eq(decode(f, -2.0), 0.0)
  assert_eq(decode(f, 2.0), 40.0)
  assert_eq(encode(f, 40.0), 2.0)
  let big = factor("big", -1.0e100, 1.0e100)
  assert_eq(decode(big, 0.0), 0.0)
  assert_eq(encode(big, 0.0), 0.0)
}

///|
test "REVIEW R03 long labels and collision families preserve model semantics" {
  let fs = [
    factor("a".repeat(128), -1.0, 1.0),
    factor("b".repeat(128), -1.0, 1.0),
  ]
  let m = terms(fs, 2)
  assert_eq(evaluate_terms([2.0, 3.0], m), [1.0, 2.0, 3.0, 6.0, 4.0, 9.0])
  let fs = [
    factor("Intercept", -1.0, 1.0),
    factor("Term1", -1.0, 1.0),
    factor("Term2", -1.0, 1.0),
  ]
  let m = terms(fs, 2)
  assert_eq(m.length(), 10)
  assert_eq(evaluate_terms([2.0, 3.0, 4.0], m), [
    1.0, 2.0, 3.0, 4.0, 6.0, 8.0, 12.0, 4.0, 9.0, 16.0,
  ])
}

///|
test "REVIEW R05 gradient enforces the evaluation dimension budget" {
  for k in [0, 17] {
    let m : Array[Term] = [{ name: "constant", powers: Array::make(k, 0), }]
    let rejected = try {
      ignore(gradient([1.0], m, Array::make(k, 0.0)))
      false
    } catch {
      DesignError::Budget(_) => true
      _ => false
    }
    assert_true(rejected)
  }
  for k in [1, 16] {
    let powers = Array::make(k, 0)
    powers[k - 1] = 2
    let m : Array[Term] = [{ name: "square", powers, }]
    let g = gradient([3.0], m, Array::make(k, 2.0))
    assert_eq(g[k - 1], 12.0)
    assert_eq(g.length(), k)
  }
}

///|
test "REVIEW R01 maximum run budget and UTF16 identifier allocation" {
  let fs = [factor("x", -1.0, 1.0)]
  let p = plan(fs, [{ id: "😀".repeat(64), block: 9, point: [0.0], }])
  let q = replicate(p, 4096)
  assert_eq(q.runs.length(), 4096)
  for r in q.runs {
    assert_true(r.id.length() <= 128)
    assert_eq(r.block, 9)
    assert_eq(r.point, [0.0])
  }
  assert_eq(p.runs[0].id, "😀".repeat(64))
}
